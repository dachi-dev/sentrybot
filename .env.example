DISCORD_TOKEN=your_discord_bot_token
ANTHROPIC_API_KEY=sk-ant-...

# Optional
SENTRY_MODEL=claude-haiku-4-5-20251001
SENTRY_STATE=sentry_state.json
# SENTRY_AUDIT_LOG=audit.jsonl   # JSON-lines audit log; defaults next to the state file
# SENTRY_ARCHIVE_BLOCKED=0       # >0 = save blocked image bytes for N days (never CSAM)
SENTRY_MAX_EDGE=768          # downscale target; lower = cheaper
SENTRY_CONCURRENCY=4         # max simultaneous Claude calls
SENTRY_GIF_FRAMES=4          # frames sampled per animated GIF/WebP (1 = first only)

DISCORD_TOKEN=your_discord_bot_token
ANTHROPIC_API_KEY=sk-ant-...

# Optional
SENTRY_MODEL=claude-haiku-4-5-20251001
SENTRY_STATE=sentry_state.json   # config store; SQLite DB is the sibling .db file
# --- Per-server Claude cost ---
# Cost is metered from the REAL token counts Claude returns on every call and priced
# at these per-million-token rates (defaults = Haiku 4.5's published $1 in / $5 out).
# Override if you switch models or the rate changes; nothing is hardcoded in the logic.
# SENTRY_PRICE_IN=1.0
# SENTRY_PRICE_OUT=5.0
# SENTRY_FLUSH_DELAY=2.0         # seconds to debounce state writes to disk
# SENTRY_AUDIT_LOG=audit.jsonl   # JSON-lines audit log; defaults next to the state file
# SENTRY_ARCHIVE_BLOCKED=0       # >0 = save blocked image bytes for N days
# SENTRY_PHASH_DISTANCE=5        # perceptual re-block threshold (0-64); <0 disables

# --- Tiers / monetization ---
# SENTRY_ALLOWLIST=              # comma-separated guild IDs with premium access
# SENTRY_FREE_SCAN_LIMIT=50      # free-tier scans per UTC day
# SENTRY_OWNER_ID=0             # your Discord user id for /sentry allowlist (0 = auto)
# --- Admin dashboard (allowlist manager) ---
# SENTRY_ADMIN_TOKEN=           # set to a strong random string to ENABLE the dashboard
# SENTRY_ADMIN_BIND=127.0.0.1:8899  # localhost => reach it over an SSH tunnel
SENTRY_MAX_EDGE=640          # downscale target; cost scales with area, lower = cheaper
SENTRY_CONCURRENCY=8         # max simultaneous Claude calls; raise on a bigger box / higher tier
SENTRY_GIF_FRAMES=3          # frames sampled per animated GIF/WebP (1 = first only)
